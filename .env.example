# Salin file ini menjadi `.env` lalu isi nilainya:  cp .env.example .env
# Jangan pernah commit `.env`.

# --- Supabase ---------------------------------------------------------------
# Buka https://supabase.com/dashboard -> pilih project -> Project Settings (ikon gear)
#   -> "API Keys" (nilai URL ada di "Data API" / tombol "Connect" di bagian atas project).

# Project URL, bentuknya https://<project-ref>.supabase.co
# Lokasi: Project Settings -> Data API -> "Project URL"
SUPABASE_URL=

# Anon key (public). Dipakai backend untuk membuat client per-request dengan token user, sehingga RLS tetap berlaku.
# Lokasi: Project Settings -> API Keys -> tab "Legacy API Keys" -> "anon" "public"
#   (jika memakai key baru, gunakan "Publishable key" di tab "Publishable and secret API keys")
SUPABASE_ANON_KEY=

# Service role key (SECRET, melewati RLS). Hanya untuk kebutuhan server/admin; jangan dipakai secara default.
# Jangan pernah dikirim ke frontend atau di-commit.
# Lokasi: Project Settings -> API Keys -> tab "Legacy API Keys" -> "service_role" "secret" (klik Reveal)
#   (key baru: "Secret key" di tab "Publishable and secret API keys")
SUPABASE_SERVICE_ROLE_KEY=

# --- Server -----------------------------------------------------------------
# Port Elysia. Nginx di production meneruskan /api/* ke port ini. Tentukan sendiri, tidak diambil dari mana pun.
PORT=3001

# --- Private Hermes assistant bridge ---------------------------------------
# Optional. When all three are set, a second API starts on 127.0.0.1 only.
# Never expose port 3002 through Nginx or commit the token.
ECONOMY_ASSISTANT_OWNER_ID=
ECONOMY_ASSISTANT_TOKEN=
ECONOMY_ASSISTANT_PORT=3002

# --- Cloudflare R2 evidence storage (private bucket; optional until configured) ---
# Create an R2 API token scoped to this bucket; keep credentials only in the backend environment.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
